{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "vite.config.ts",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "linter": {
    "enabled": true
  }
}
